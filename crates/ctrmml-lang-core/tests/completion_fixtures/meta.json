  {
    "name": "meta_keywords_require_hash_as_first_non_ws",
    "notes": "D6 strict predicate: `#` must be the first non-whitespace character of the line, so `x #ti` yields NO meta keywords and falls through to the command fallback.",
    "decisions": ["D6", "D19"],
    "doc": "x #ti",
    "pos": {"line": 0, "character": 5},
    "trigger": null,
    "data": null,
    "expect": {
      "plan": "done",
      "is_incomplete": true,
      "count": 37,
      "items_spot": [
        {"index": 0, "label": "cdefgabh", "kind": "function", "insert": "c", "filter_text": "notes", "sort_text": "000", "range": {"start_character": 3, "end_character": 5}}
      ]
    }
  },

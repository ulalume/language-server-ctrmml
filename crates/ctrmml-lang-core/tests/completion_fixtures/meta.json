        {"label": "#option", "kind": "keyword", "detail": "Sets platform options.", "insert": "option", "insert_format": "plain", "filter_text": "#option", "sort_text": "007", "command": "trigger_suggest", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#group", "kind": "keyword", "detail": "MDSDRV song group.", "insert": "group", "insert_format": "plain", "filter_text": "#group", "sort_text": "008", "command": "trigger_suggest", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#game", "kind": "keyword", "detail": "Song metadata.", "insert": "game", "insert_format": "plain", "filter_text": "#game", "sort_text": "009", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#composerj", "kind": "keyword", "detail": "Song metadata.", "insert": "composerj", "insert_format": "plain", "filter_text": "#composerj", "sort_text": "010", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#license", "kind": "keyword", "detail": "License information.", "insert": "license", "insert_format": "plain", "filter_text": "#license", "sort_text": "011", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#timesig", "kind": "keyword", "detail": "Time signature for piano roll.", "insert": "timesig", "insert_format": "plain", "filter_text": "#timesig", "sort_text": "012", "command": "trigger_suggest", "range": {"start_character": 1, "end_character": 3}}

[
  {
    "name": "meta_keywords_after_hash",
    "notes": "D6: range starts AFTER the `#` (character 1) and the insert carries no `#` (RS mechanism); TriggerSuggest only on the 4 value-taking keywords. Table detail/filter/sort rendering is shared, and §3.1-4 requires documentation to be absent when the table doc is empty (asserted on #author).",
    "decisions": ["D6", "D17"],
    "doc": "#ti",
    "pos": {"line": 0, "character": 3},
    "trigger": null,
    "data": null,
    "expect": {
      "plan": "done",
      "is_incomplete": false,
      "items": [
        {"label": "#title", "kind": "keyword", "detail": "Song title.", "insert": "title", "insert_format": "plain", "filter_text": "#title", "sort_text": "000", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#composer", "kind": "keyword", "detail": "Original composer.", "insert": "composer", "insert_format": "plain", "filter_text": "#composer", "sort_text": "001", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#programmer", "kind": "keyword", "detail": "MML programmer.", "insert": "programmer", "insert_format": "plain", "filter_text": "#programmer", "sort_text": "002", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#author", "kind": "keyword", "detail": "Song metadata.", "insert": "author", "insert_format": "plain", "filter_text": "#author", "sort_text": "003", "assert_absent": ["documentation"], "range": {"start_character": 1, "end_character": 3}},
        {"label": "#date", "kind": "keyword", "detail": "Song metadata.", "insert": "date", "insert_format": "plain", "filter_text": "#date", "sort_text": "004", "range": {"start_character": 1, "end_character": 3}},
        {"label": "#comment", "kind": "keyword", "detail": "Song metadata.", "insert": "comment", "insert_format": "plain", "filter_text": "#comment", "sort_text": "005", "range": {"start_character": 1, "end_character": 3}},
